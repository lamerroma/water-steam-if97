    "description": {
      "path": "ht.LMTD",
      "kind": "function",
      "signature": "(Thi: 'float', Tho: 'float', Tci: 'float', Tco: 'float', counterflow: 'bool' = True) -> 'float'",
      "parameters": [
        {
