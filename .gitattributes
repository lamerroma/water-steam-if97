# Deterministic source, vendored checksums and release assets on every checkout.
* text=auto eol=lf
*.wasm -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.zip -text
*.whl -text
*.pdf -text
*.woff -text
*.woff2 -text
*.xlsx -text
*.xls -text
*.ods -text
# Downloaded CSV evidence retains its original UTF-8 BOM and CRLF bytes.
docs/steam97-p08/samples/*.csv -text whitespace=cr-at-eol
# Preserve upstream license bytes, including their original whitespace.
vendor/python/licenses/*.txt whitespace=-blank-at-eof,-blank-at-eol
assets/python/*/licenses/*.txt whitespace=-blank-at-eof,-blank-at-eol
dist/assets/python/*/licenses/*.txt whitespace=-blank-at-eof,-blank-at-eol
# The generated worker retains the bundler's separators between source files.
**/python-worker.js whitespace=-blank-at-eof
