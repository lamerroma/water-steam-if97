# Deterministic source, vendored checksums and release assets on every checkout.
* text=auto eol=lf
*.wasm -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.zip -text
*.whl -text
*.pdf -text
*.woff -text
*.woff2 -text
*.xlsx -text
*.xls -text
*.ods -text
# Downloaded CSV evidence retains its original UTF-8 BOM and CRLF bytes.
docs/steam97-p08/samples/*.csv -text whitespace=cr-at-eol
# Byte-exact 1.41.0 evidence, including downloaded CSV/JSON and AX snapshots.
docs/release-1.41.0/** -text whitespace=-blank-at-eof,-blank-at-eol,cr-at-eol
# Historical browser evidence is byte-for-byte source material with SHA-256.
docs/steam97-reference/steam97-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
docs/steam97-reference/STEAM97_REFERENCE_REPORT_UK.md -text
docs/steam97-reference/steam97-reference-cases.json -text
# Preserve captured CSV/log/JSON bytes named in the R01 SHA-256 manifests.
docs/development-r01/evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
docs/development-r01/steam-process-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
docs/development-r01/auxiliary-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Preserve upstream license bytes, including their original whitespace.
vendor/python/licenses/*.txt whitespace=-blank-at-eof,-blank-at-eol
assets/python/*/licenses/*.txt whitespace=-blank-at-eof,-blank-at-eol
dist/assets/python/*/licenses/*.txt whitespace=-blank-at-eof,-blank-at-eol
# The generated worker retains the bundler's separators between source files.
**/python-worker.js whitespace=-blank-at-eof

# Byte-exact R01 memory evidence.
docs/development-r01/memory-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Byte-exact R02 evidence; browser profiles remain ignored.
docs/development-r02/evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
docs/development-r02/upgrade-evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Byte-exact startup restoration proof artifacts.
docs/release-1.41.1/evidence/** -text whitespace=-blank-at-eof,-blank-at-eol,cr-at-eol
